# Set ordered factor
group_levels <- c(
  "FL_LP12", "FL_LP13", "FL_LP14A", "FL_LP14B",
  "CB_LP12", "CB_LP13", "CB_LP14",
  "BM_LP12", "BM_LP13"
)

df_all$Group_source <- factor(df_all$Group_source, levels = group_levels)

# Prepare long-form data
df_pos_long <- df_all %>%
  select(source, Group, Group_source, B_pos, NK_pos, Mk_pos, RBC_pos, Mono_pos) %>%
  pivot_longer(cols = ends_with("_pos"), names_to = "Lineage", values_to = "Positive") %>%
  mutate(Lineage = str_remove(Lineage, "_pos"),
         Positive = as.numeric(Positive)) %>%
  filter(Group != "CB")

# Set plot labels
group_labels <- c(
  "FL_LP14A" = "FL_8pcw_#1",
  "FL_LP14B" = "FL_8pcw_#2",
  "FL_LP12" = "FL_9pcw",
  "FL_LP13" = "FL_8.5pcw",
  "BM_LP12" = "BM_#1",
  "BM_LP13" = "BM_#2"
)

label_levels <- group_labels[names(group_labels)]

# Prepare data for plotting
plot_df <- df_pos_long %>%
  mutate(Group_label = group_labels[as.character(Group_source)]) %>%
  filter(!is.na(Group_label)) %>%
  mutate(
    Group_label = factor(Group_label, levels = label_levels),
    PositiveLabel = ifelse(Positive == 1, Lineage, paste0("non-", Lineage))
  ) %>%
  group_by(Group_label, Lineage, PositiveLabel) %>%
  summarise(n = n(), .groups = "drop") %>%
  group_by(Group_label, Lineage) %>%
  mutate(proportion = n / sum(n)) %>%
  ungroup()



# === 1. Filter for positive cases only ===
plot_df_pos_only <- plot_df %>%
  filter(PositiveLabel == Lineage)

# === 2. Ensure all Group_label × Lineage combinations exist ===
all_combinations <- expand.grid(
  Group_label = unique(plot_df$Group_label),
  Lineage = unique(plot_df$Lineage)
)

# === 3. Join with actual data and replace missing proportions with 0 ===
plot_df_pos_filled <- all_combinations %>%
  left_join(plot_df_pos_only, by = c("Group_label", "Lineage")) %>%
  mutate(
    proportion = replace_na(proportion, 0),
    Group = str_extract(as.character(Group_label), "^[^_]+")  # Extract 'FL', 'BM', etc.
  )

# === 4. Calculate group-wise mean and standard error (SE) ===
summary_df <- plot_df_pos_filled %>%
  group_by(Group, Lineage) %>%
  summarise(
    mean_prop = mean(proportion),
    se_prop = sd(proportion) / sqrt(n()),
    .groups = "drop"
  )

