# Processing function
process_df <- function(df) {
  df %>%
    mutate(
      Sample = ...1,
      Group = case_when(
        str_detect(Sample, "^BM") ~ "BM",
        str_detect(Sample, "^CB") ~ "CB",
        str_detect(Sample, "^FL") ~ "FL"
      ),
      B_pos =`B(inclCD11b)` >= cut_off,
      NK_pos = `NKp46+(inclCD11b)` >= cut_off,
      Mono_pos = Mono >= cut_off,
      RBC_pos = RBC >= cut_off,
      Mk_pos = Mk >= cut_off
    )
}

df_all <- process_df(df_all)

# Positivity category
df_all <- df_all %>%
  rowwise() %>%
  mutate(
    n_positive = sum(c_across(ends_with("_pos"))),
    PositivityCategory = case_when(
      n_positive == 0 ~ "non-defined",
      n_positive == 1 ~ "1 positive",
      n_positive == 2 ~ "2 positives",
      n_positive >= 3 ~ "3+ positives"
    )
  ) %>%
  ungroup() %>%
  filter(!is.na(Group)) %>%
  mutate(Group = factor(Group, levels = c("FL", "CB", "BM")))

