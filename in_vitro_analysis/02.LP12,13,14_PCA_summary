library(tidyverse)
library(readxl)
library(ggplot2)
library(viridis)
library(patchwork)
set.seed(123)
setwd("")##set work dicrectory

lineage_colors <- c(
  "B" = "#785EF0",
  "NK" = "lightgreen",
  "Mono" = "#648FFF",
  "Mk" = "lightpink2",
  "RBC" = "red"
)

origin_colors <- c(
  "BM" = '#1b4b1f',
  "FL" = '#1c6494'
)

# ========= 1. Read and preprocess RO files =========
      read_and_format_ro <- function(filepath, source_label) {
        df <- read_excel(filepath) %>%
          mutate(source = source_label,
                   Sample = ...1, 
                   Group = case_when(
                     grepl("^BM", Sample) ~ "BM",
                     grepl("^CB", Sample) ~ "CB",
                     grepl("^FL", Sample) ~ "FL")
                 ) %>%
          as.data.frame()
        rownames(df) <- paste(df$source, df$...1, sep = "_")
        df <- df[, !colnames(df) %in% "source"]
        df <- df[, -1]  # remove ...1
        return(df)
      }
      
            LP12_RO <- read_and_format_ro("LP12_RO.xls", "LP12")
            LP13_RO <- read_and_format_ro("LP13_RO.xls", "LP13")

      read_and_format_ro_lp14 <- function(filepath) {
        df <- read_excel(filepath) %>%
          mutate(
            Sample = ...1,
            source = case_when(
              grepl("^FL[1-3]", Sample) ~ "LP14A",
              grepl("^FL[4-6]", Sample) ~ "LP14B",
              TRUE ~ "LP14"  #
            ))  %>%
          as.data.frame()
        
        rownames(df) <- paste(df$source, df$Sample, sep = "_")
        # ✅ rownames(df)  to Group
        df$Group <- case_when(
          grepl("_(BM)", rownames(df)) ~ "BM",
          grepl("_(CB)", rownames(df)) ~ "CB",
          grepl("_(FL)|LP14A_|LP14B_", rownames(df)) ~ "FL",
          TRUE ~ NA_character_
        )
        df <- df[, !colnames(df) %in% c("source","...1")]  # delete unnecessary
        return(df)
      }
            LP14_RO <- read_and_format_ro_lp14("LP14_RO.xls")






combined <- rbind(LP12_RO, LP13_RO,LP14_RO) %>%
  filter(!is.na(Group)) %>%
  filter(Group %in% c("FL", "BM")) 



# ========= 2. Remove B and NK columns for PCA, normalize by Alive =========
combined_for_pca <- combined[, !colnames(combined) %in% c("B", "NK","Group","Sample")]
alive_values <- combined_for_pca$Alive

normalized <- combined_for_pca
normalized[, colnames(normalized) != "Alive"] <- sweep(
  normalized[, colnames(normalized) != "Alive"],
  1,
  alive_values,
  FUN = "/"
)
normalized <- normalized[, colnames(normalized) != "Alive"]

# ========= 3. PCA on normalized data =========
pca_result <- prcomp(normalized, center = TRUE, scale. = TRUE)
pca_df <- as.data.frame(pca_result$x)

# ========= 4. Add origin label and raw marker counts =========
pca_df$origin <- case_when(
  grepl("_(BM)", rownames(pca_df)) ~ "BM",
  grepl("_(CB)", rownames(pca_df)) ~ "CB",
  grepl("_(FL)|LP14A_|LP14B_", rownames(pca_df)) ~ "FL"
)
pca_df <- pca_df %>% filter(!is.na(origin))




pca_df$B_ratio   <- normalized[rownames(pca_df), "B(inclCD11b)"]
pca_df$NK_ratio   <- normalized[rownames(pca_df), "NKp46+(inclCD11b)"]
pca_df$Mono_ratio <- normalized[rownames(pca_df), "Mono"]
pca_df$RBC_ratio  <- normalized[rownames(pca_df), "RBC"]
pca_df$Mk_ratio  <- normalized[rownames(pca_df), "Mk"]

# ========= 5. Plot individual marker distributions in PCA =========

p1 <- ggplot(pca_df, aes(x = PC1, y = PC2, fill = B_ratio)) +
  geom_point(size = 3, shape = 21, color = "black", stroke = 0.3) +
  scale_fill_gradient(low = "white", high = lineage_colors["B"]) +
  theme_classic() +
  labs(title = "B cell ratio", fill = "B / Alive")

p4 <- ggplot(pca_df, aes(x = PC1, y = PC2, fill = NK_ratio)) +
