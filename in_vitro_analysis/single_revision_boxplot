##FOR STATISTIC OF NEW DATA
df_test <- df_all %>%
  mutate( Organ = case_when(str_detect(as.character(Group), "^FL") ~ "FL",
                            str_detect(as.character(Group), "^CB") ~ "CB",
                            str_detect(as.character(Group), "^BM") ~ "BM" ),
    Organ = factor(Organ, levels = c("FL","CB","BM")))
library(rstatix)
kw_res <- df_test %>%
  select(Organ, condition, B, Mono) %>%
  pivot_longer( cols = c(B, Mono),names_to = "fraction",values_to = "value") %>%
  group_by(fraction, condition) %>% kruskal_test(value ~ Organ)
  write.csv(kw_res, file.path(out_dir, "LP17-19_B_Mono_Kruskal.csv"), row.names = FALSE)

dunn_res <- df_test %>%
  select(Organ, condition, B, Mono) %>%
  pivot_longer( cols = c(B, Mono),names_to = "fraction",values_to = "value" ) %>%
  group_by(fraction, condition) %>%
  dunn_test(value ~ Organ,p.adjust.method = "BH") %>%
  mutate( p_label = case_when(p.adj < 0.001 ~ "***",
                              p.adj < 0.01  ~ "**",
                              p.adj < 0.05  ~ "*",TRUE ~ "ns" ))
  dunn_sig <- dunn_res %>%
    filter(p.adj < 0.05)
  write.csv(dunn_sig, file.path(out_dir, "LP17-19_B_Mono_Dunn_significant.csv"),row.names = FALSE)






