cluster_names <- c("Ly-II", "HSC", "GMP","DC-Mono")
for (cluster_name in cluster_names) {
  ly_cluster_cells <- which(colData(cds)$"clust.names" == cluster_name)
  closest_vertex <- cds@principal_graph_aux[["UMAP"]]$pr_graph_cell_proj_closest_vertex
  closest_vertex <- as.matrix(closest_vertex[colnames(cds), ])
  ly_nodes <- closest_vertex[ly_cluster_cells, ]
  ly_node_counts <- table(ly_nodes)
  selected_node <- names(which.max(ly_node_counts))
  print(paste("Selected node for", cluster_name, ":", selected_node))
}

