# starting with haromony integration
library(Seurat)
library(harmony)
library(SeuratWrappers)

set.seed(123)
FL.combined<-readRDS("FILE PATH")
yBM<-readRDS("FILE PATH")
FL.combined$dataset<-"FL"
yBM$dataset<-"BM"
FL_BM.combined <- merge(FL.combined, yBM, add.cell.ids = c('FL', 'BM'), project = 'FL_BM_merge')
DefaultAssay(FL_BM.combined) <- "RNA"
s.genes <- cc.genes$s.genes
g2m.genes <- cc.genes$g2m.genes

FL_BM.combined <- CellCycleScoring(FL_BM.combined, s.features = s.genes, g2m.features = g2m.genes, set.ident = TRUE)
FL_BM.combined <- NormalizeData(FL_BM.combined, verbose = F)
FL_BM.combined <- FindVariableFeatures(FL_BM.combined, verbose = F)
FL_BM.combined <- ScaleData(FL_BM.combined, vars.to.regress = c("S.Score", "G2M.Score"), verbose = F)
FL_BM.combined <- RunPCA(FL_BM.combined, verbose = F)
table(FL_BM.combined@meta.data$orig.ident)
FL_BM.combined <- RunHarmony(FL_BM.combined, group.by.vars = "orig.ident")
FL_BM.combined@reductions$harmony_RNA <- FL_BM.combined@reductions$harmony
FL_BM.combined <- FindNeighbors(FL_BM.combined,reduction = "harmony_RNA", dims = 1:15, assay = "integrated", graph.name = c("NNharmonyRNA", "SNNharmonyRNA"))
FL_BM.combined <- FindClusters(FL_BM.combined,graph.name = "SNNharmonyRNA",resolution = 0.8)
FL_BM.combined[["clusters_RNA_harmony"]] <- Idents(FL_BM.combined)

#The FL CS22 and adult BM data sets were integrated with Harmony (version 0.1.0).21 
#The FL and BM Seurat objects were merged (merge function). The data were log-normalized, 
#and highly variable genes were calculated with the FindVariableFeatures function. 
#Cell cycle effects were regressed out using the ScaleData function. 
#PCA was calculated using the RunPCA function, after which the RunHarmony function was used. 
#The Harmony reduction was then used in FindNeighbors (dimensions 1:15), FindClusters (resolution = 0.8), 
#and RunUMAP (dimensions 1:15, 15 neighbors, minimum distance = 0.005, spread = 6). 
#The metadata and the UMAP coordinates were exported and used in Python for visualization.

FL_BM.combined <- RunUMAP(FL_BM.combined, reduction = "harmony_RNA", dims = 1:15, 
	reduction.name = "UMAPharmonyRNA", reduction.key = "UMAPharmonyRNA_", 
	assay = "integrated", n.neighbors = 15, min.dist = 2, spread = 5)


FL_BM.combined@meta.data$combined_clusts <- ifelse(
  !is.na(FL_BM.combined@meta.data$clust.names),
  paste('FL', FL_BM.combined@meta.data$clust.names, sep = '_'),  #label the FL_ for the FL-derived cells
  ifelse(
    !is.na(FL_BM.combined@meta.data$paper_clusters),
    paste('BM', FL_BM.combined@meta.data$paper_clusters, sep = '_'),  #label the BM_ for the BM-derived cells
    NA 
  )
)


