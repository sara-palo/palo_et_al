# Load required libraries
library(tidyverse)
library(readxl)
library(patchwork)
library(scales)

# Set working directory and cutoff
setwd("D:/LP/")
cut_off <- 50

# Define lineage colors
lineage_colors <- c(
  "B" = "#648FFF",
  "NK" = "#785EF0",
  "Mono" = "#DC267F",
  "Mk" = "#FFB000",
  "RBC" = "#FE6100"
)

# Load data from each source
df_all1 <- read_excel("LP12/LP12_RO.xls") %>% mutate(source = "LP12")
df_all2 <- read_excel("LP13/LP13_RO.xls") %>% mutate(source = "LP13")
df_all3 <- read_excel("LP14/LP14_RO.xls") %>%
  mutate(source = case_when(
    str_detect(...1, "^FL[123]") ~ "LP14A",
    str_detect(...1, "^FL[456]") ~ "LP14B",
    TRUE ~ "LP14"
  ))

df_all <- bind_rows(df_all1, df_all2, df_all3)

# Process data and assign groups
df_all <- df_all %>%
  mutate(Sample = ...1) %>%
  mutate(
    Group = case_when(
      grepl("^BM", Sample) ~ "BM",
      grepl("^CB", Sample) ~ "CB",
      grepl("^FL", Sample) ~ "FL"
    ),
    B_pos = B >= cut_off,
    NK_pos = NK >= cut_off,
    Mono_pos = Mono >= cut_off,
    RBC_pos = RBC >= cut_off,
    Mk_pos = Mk >= cut_off
  ) %>%
  rowwise() %>%
  mutate(
    n_positive = sum(c_across(ends_with("_pos"))),
    PositivityCategory = case_when(
      n_positive == 0 ~ "non-defined",
      n_positive == 1 ~ "1 positive",
      n_positive == 2 ~ "2 positives",
      n_positive >= 3 ~ "3+ positives"
    )
  ) %>%
  ungroup() %>%
  filter(!is.na(Group))

df_all$Group <- factor(df_all$Group, levels = c("FL", "CB", "BM"))
write.csv(df_all, "data_for_graph_LP12.13.14_cutoff50.csv")

# Bar plots (FL vs BM)
df_flbm <- df_all %>% filter(Group %in% c("FL", "BM"))

p1 <- ggplot(df_flbm, aes(x = Group, fill = PositivityCategory)) +
  geom_bar() +
  scale_fill_manual(values = c(
    "non-defined" = "#DADAEB",
    "1 positive" = "#4A1486",
    "2 positives" = "#807DBA",
    "3+ positives" = "#BCBDDC"
  )) +
  labs(title = "Lineage marker positivity per well (FL & BM)", y = "Wells", x = "Group") +
  theme_minimal()

p2 <- ggplot(df_flbm, aes(x = Group, fill = PositivityCategory)) +
  geom_bar(position = "fill") +
  scale_fill_manual(values = c(
    "non-defined" = "#DADAEB",
    "1 positive" = "#4A1486",
    "2 positives" = "#807DBA",
    "3+ positives" = "#BCBDDC"
  )) +
  labs(title = "Proportion of lineage marker positivity (FL & BM)", y = "Proportion", x = "Group") +
  theme_minimal()

pdf("LP_clone_50_FL_BM.pdf", width = 8, height = 4)
p1 + p2
dev.off()

# Add positivity combinations
df_all <- df_all %>%
  rowwise() %>%
  mutate(PositivityCombo = paste(
    c(if (B_pos) "B", if (NK_pos) "NK", if (Mono_pos) "Mono", if (RBC_pos) "RBC", if (Mk_pos) "Mk"),
    collapse = "_"
  )) %>%
  mutate(PositivityCombo = ifelse(PositivityCombo == "", "None", PositivityCombo)) %>%
  ungroup() %>%
  mutate(Group_source = paste(Group, source, sep = "_"))

# Set factor order
df_all$Group_source <- factor(df_all$Group_source, levels = c(
  "FL_LP12", "FL_LP13", "FL_LP14A", "FL_LP14B",
  "CB_LP12", "CB_LP13", "CB_LP14",
  "BM_LP12", "BM_LP13"
))

# Long-format positivity data
df_pos_long <- df_all %>%
  select(source, Group, Group_source, B_pos, NK_pos, Mk_pos, RBC_pos, Mono_pos) %>%
  pivot_longer(cols = ends_with("_pos"), names_to = "Lineage", values_to = "Positive") %>%
  mutate(Lineage = str_remove(Lineage, "_pos"), Positive = as.numeric(Positive)) %>%
  filter(Group != "CB")

# Assign display labels
group_labels <- c(
  "FL_LP12" = "FL_9pcw",
  "FL_LP13" = "FL_8.5pcw",
  "FL_LP14A" = "FL_8pcw_#1",
  "FL_LP14B" = "FL_8pcw_#2",
  "BM_LP12" = "BM_#1",
  "BM_LP13" = "BM_#2"
)

label_levels <- group_labels[names(group_labels)]

plot_df <- df_pos_long %>%
  mutate(Group_source = factor(Group_source, levels = names(group_labels)),
         Group_label = factor(group_labels[as.character(Group_source)], levels = label_levels)) %>%
  mutate(PositiveLabel = ifelse(Positive == 1, Lineage, paste0("non-", Lineage))) %>%
  group_by(Group_source, Lineage, PositiveLabel) %>%
  summarise(n = n(), .groups = "drop") %>%
  group_by(Group_source, Lineage) %>%
  mutate(proportion = n / sum(n)) %>%
  ungroup()

# Plot function
plot_lineage_bar <- function(target_lineage, bar_color) {
  df <- plot_df %>%
    filter(Lineage == target_lineage) %>%
    mutate(PositiveLabel = factor(
      PositiveLabel,
      levels = c(paste0("non-", target_lineage), target_lineage)
    ))
  
  ggplot(df, aes(x = Group_label, y = proportion, fill = PositiveLabel)) +
    geom_bar(stat = "identity", width = 0.7, color = "black", position = "stack") +
    scale_fill_manual(
      values = setNames(c("black", bar_color), c(paste0("non-", target_lineage), target_lineage))
    ) +
    scale_y_continuous(labels = scales::percent_format()) +
    theme_classic(base_size = 14) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
    labs(
      title = paste(target_lineage, "positive ratio"),
      x = "Sample", y = "Percent of total", fill = NULL
    )
}

# Generate and save plots
pdf("LP_positiveratio_50_FL_BM.pdf", width = 12, height = 6)
wrap_plots(
  plot_lineage_bar("B", "#648FFF"),
  plot_lineage_bar("NK", "#785EF0"),
  plot_lineage_bar("Mono", "#DC267F"),
  plot_lineage_bar("Mk", "#FFB000"),
  plot_lineage_bar("RBC", "#FE6100"),
  ncol = 3
)
dev.off()

